pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Backend build & test') {
            steps {
                dir('backend') {
                    sh 'mvn -B clean verify'
                }
            }
        }
        stage('Frontend build') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
        }
        stage('Docker images') {
            when { branch 'main' }
            steps {
                echo 'Build/push service images — wire registry in production'
            }
        }
    }
    post {
        always {
            junit 'backend/**/target/surefire-reports/*.xml'
        }
    }
}